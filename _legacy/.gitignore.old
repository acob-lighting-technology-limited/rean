# REAN: single .gitignore for frontend/ (Next.js) and backend/ (Sanity Studio).
# Patterns without a leading slash match at any depth, so they cover both folders.

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# frontend: Next.js build output
.next/
out/
build/
next-env.d.ts

# backend: Sanity Studio build output and local state
dist/
.sanity/

# testing
coverage/

# environment files: commit placeholders only
.env
.env.*
!.env.example

# deploy tooling
.vercel

# typescript
*.tsbuildinfo

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# misc
.DS_Store
Thumbs.db
*.pem

design-preview.png
assets/
ui-mockups
frontend/images/


AGENTS.md
frontend/design_tokens.md
frontend/README.md

backend/MASTER_PROMPT.md
multi-agent.md