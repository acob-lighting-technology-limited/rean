# Public URL of the deployed site (used for canonical links, sitemap and share previews)
NEXT_PUBLIC_SITE_URL=https://example.com

# Contact channels — leave blank to hide a channel. Nothing is ever shown as a fake value.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_PUBLISHED_BY=

# Pledge / question form delivery via Resend. The only secret: without it, the form says it isn't live yet.
RESEND_API_KEY=
# Optional overrides; defaults in src/lib/site.ts (info@ and pledges@alexanderobiechina.com).
# PLEDGE_TO_EMAIL=
# PLEDGE_FROM_EMAIL=
